{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "downloadhub",
  "version": "1.0.4",
  "identifier": "io.erwinlovecraft.downloadhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MDQ4QzBERjM4MkMwNUMKUldSY3dJTHpEWXdFZWU0cEtiQThrOVZlRjVER280VjFBVWljK29vY1hpQTc5MEFwVHM3M2xDa04K",
      "endpoints": [
        "https://github.com/erwin-lovecraft/downloadhub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "downloadhub",
        "width": 1100,
        "height": 750,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/mcp-server"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../README.md": "README.md",
      "../docs/MCP_SETUP.md": "MCP_SETUP.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
