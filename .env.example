# Copy to .env (gitignored) and fill in your own Google OAuth "Desktop app"
# client credentials. Create one at https://console.cloud.google.com/apis/credentials
# (Application type: Desktop app). See README.md for details.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# API key for YouTube Data API v3 (search.list/videos.list). Create one at
# https://console.cloud.google.com/apis/credentials (Application restriction:
# none needed for a desktop app; API restriction: YouTube Data API v3).
YOUTUBE_API_KEY=
